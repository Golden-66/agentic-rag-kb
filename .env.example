# ===== LLM (任意 OpenAI 兼容接口: DeepSeek / 通义千问 / OpenAI / 本地 vLLM、Ollama 等) =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# ===== 可选: 文档图片描述 (VLM) =====
VLM_ENABLED=false
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=sk-xxxx
# VLM_MODEL=qwen-vl-max

# ===== 本地模型 (首次启动会自动从 HuggingFace 下载, 国内可设置 HF_ENDPOINT=https://hf-mirror.com) =====
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 仅 GPU 有效; 纯 CPU 运行时可忽略
USE_FP16=true

# ===== 文档解析 =====
# mineru | pymupdf
PARSER_BACKEND=mineru
# MinerU 不可用时回退到 pymupdf4llm (不支持扫描件 OCR)
PARSER_FALLBACK=true
# docker 构建时是否在镜像内安装 MinerU
INSTALL_MINERU=false

# ===== 鉴权 (留空则不启用) =====
API_KEY=
